# Copy to .env and adjust. Everything runs locally; there are no API keys.

# Web server
HOST=127.0.0.1
PORT=3000

# PostgreSQL 16 (start it with: sudo pg_ctlcluster 16 main start)
DATABASE_URL=postgres://scanner:scanner@127.0.0.1:5432/offline_scanner

# Where photos and spine crops are stored
DATA_DIR=./data

# OCR engine: "tesseract" (Node, default) or "rapidocr" (Python sidecar in tools/rapidocr)
OCR_ENGINE=tesseract

# Never let Playwright try to download browsers; use the preinstalled Chromium.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# Optional: set if Playwright can't find the preinstalled Chromium by itself.
# PLAYWRIGHT_CHROMIUM_PATH=/path/to/chrome
